# Copy to .env and fill in. Never commit .env.
#
# mda reads .env, uses LANGSMITH_API_KEY for LangSmith, and forwards your model
# provider key as a deployment secret.

LANGSMITH_API_KEY=
ANTHROPIC_API_KEY=

# Optional: target a specific workspace on deploy.
# LANGSMITH_WORKSPACE_ID=

# Slack needs nothing here. Authorize at the Connect Slack prompt during
# mda deploy, and the bot token is stored as a workspace connection.
